{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:web-blink:schema:sources:1",
  "title": "Web Blink sources distribution contract v1 (draft)",
  "x-blink-schema": {
    "version": "1.1.0",
    "released": "2026-10-30"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "urn:web-blink:schema:sources:1"
    },
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "ref",
          "catalogPath",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])",
            "not": {
              "const": "builtin"
            }
          },
          "repository": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?/[A-Za-z0-9._~/-]+(?![\\s\\S])"
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(?![\\s\\S])",
            "not": {
              "pattern": "(?:\\.\\.|//|\\.lock(?:/|$)|[./]$|/\\.)"
            }
          },
          "catalogPath": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json(?![\\s\\S])"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "x-blink-schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "released": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(?![\\s\\S])"
        }
      }
    },
    "x-blink-ext": {
      "type": "object",
      "maxProperties": 100,
      "description": "Reserved extension object for additive data; readers ignore what they do not understand."
    }
  },
  "patternProperties": {
    "^x-(?!blink-)": {}
  }
}
