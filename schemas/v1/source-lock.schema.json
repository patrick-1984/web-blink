{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:web-blink:schema:source-lock:1",
  "title": "Web Blink source-lock distribution contract v1 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "sources",
    "installed"
  ],
  "properties": {
    "$schema": {
      "const": "urn:web-blink:schema:source-lock:1"
    },
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "requestedRef",
          "commit",
          "catalogPath",
          "catalogSha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])",
            "not": {
              "const": "builtin"
            }
          },
          "repository": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?/[A-Za-z0-9._~/-]+(?![\\s\\S])"
          },
          "requestedRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(?![\\s\\S])",
            "not": {
              "pattern": "(?:\\.\\.|//|\\.lock(?:/|$)|[./]$|/\\.)"
            }
          },
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
          },
          "catalogPath": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json(?![\\s\\S])"
          },
          "catalogSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "installed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "id",
          "version",
          "descriptor",
          "descriptorSha256",
          "snapshot"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])",
            "not": {
              "const": "builtin"
            }
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])"
          },
          "version": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
          },
          "descriptor": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json(?![\\s\\S])"
          },
          "descriptorSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "commit",
              "catalogPath",
              "catalogSha256"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?/[A-Za-z0-9._~/-]+(?![\\s\\S])"
              },
              "commit": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
              },
              "catalogPath": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json(?![\\s\\S])"
              },
              "catalogSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            }
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000
    }
  }
}
