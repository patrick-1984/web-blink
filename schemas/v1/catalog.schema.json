{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:web-blink:schema:catalog:1",
  "title": "Web Blink catalog distribution contract v1 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "name",
    "weblinks"
  ],
  "properties": {
    "$schema": {
      "const": "urn:web-blink:schema:catalog:1"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "weblinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "descriptor",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*(?![\\s\\S])"
          },
          "version": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
          },
          "descriptor": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json(?![\\s\\S])"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000
    }
  }
}
