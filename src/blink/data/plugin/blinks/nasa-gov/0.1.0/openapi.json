{
  "openapi": "3.1.0",
  "x-blink-schema": {
    "version": "1.1.0"
  },
  "info": {
    "title": "NASA news releases",
    "version": "0.1.0",
    "description": "Public NASA news releases from www.nasa.gov, read through the JSON the website itself uses. Read-only; no account."
  },
  "servers": [
    {
      "url": "https://www.nasa.gov"
    }
  ],
  "x-blink-service": {
    "id": "nasa-gov",
    "version": "0.1.0",
    "history": [
      {
        "version": "0.1.0",
        "date": "2026-11-09",
        "note": "Quick-start example: newest public NASA news releases"
      }
    ],
    "requestedOrigins": [
      "https://www.nasa.gov"
    ],
    "appOrigin": "https://www.nasa.gov",
    "auth": {
      "kind": "none"
    },
    "exec": {
      "allowed": [
        "direct"
      ],
      "preferred": "direct"
    }
  },
  "paths": {
    "/wp-json/wp/v2/press-release": {
      "get": {
        "operationId": "latestNews",
        "summary": "Newest NASA news releases, optionally only those that mention a word",
        "x-blink-effect": "read",
        "x-blink-notes": "Public US federal website (OMB M-23-22 permits scraping of federal public web content). Newest first.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "description": "Only releases that mention this word anywhere in the text, e.g. moon"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 5,
              "description": "How many releases (1-50)"
            }
          },
          {
            "name": "_fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "date,title.rendered,link"
              ],
              "default": "date,title.rendered,link",
              "description": "Returned fields (fixed)"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "News releases, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "date",
                      "title",
                      "link"
                    ],
                    "properties": {
                      "date": {
                        "type": "string"
                      },
                      "link": {
                        "type": "string"
                      },
                      "title": {
                        "type": "object",
                        "properties": {
                          "rendered": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
